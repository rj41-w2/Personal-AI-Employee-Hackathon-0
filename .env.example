# ======================================
# Personal AI Employee - Environment Config
# ======================================
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to version control.

# --- LinkedIn API ---
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth2_access_token_here
LINKEDIN_PERSON_URN=urn:li:person:YOUR_PERSON_ID

# --- Google Gemini API (Cloud LLM) ---
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Odoo ERP ---
ODOO_URL=http://localhost:8069
ODOO_DB=ai_employee_db
ODOO_USERNAME=your_odoo_username
ODOO_PASSWORD=your_odoo_password
ODOO_POSTGRES_PASSWORD=generate_a_long_random_password

# --- Dashboard API ---
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Live action safety ---
# Keep false for development/demo mode. When false, Approved files are dry-run only.
ENABLE_LIVE_ACTIONS=false
EMAIL_ALLOWED_RECIPIENTS=
EMAIL_ALLOWED_DOMAINS=
LINKEDIN_POSTING_ENABLED=false
ODOO_READ_ACTIONS_ENABLED=false
ODOO_WRITE_ACTIONS_ENABLED=false
